# ---- Core ----
# Postgres connection string. Use sslmode=require (or verify-full in prod).
DATABASE_URL=postgresql://user:password@localhost:5432/spektr?sslmode=require
# Must be at least 32 characters (enforced by env.validation.ts).
JWT_SECRET=
# One of: development | production | test
NODE_ENV=development
PORT=3001
FRONT_URL=http://localhost:3000

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ---- SMTP (e.g. Brevo) ----
SMTP_USER=
SMTP_PASS=
# Optional: must be a valid email if set.
SMTP_FROM=no-reply@spektr.local

# ---- MinIO object storage ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Set to true to use HTTPS (required in production).
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=spektr
