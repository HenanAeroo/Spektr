generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(255)
  first_name  String?
  last_name   String?
  role        Role     @default(STUDENT)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  authProviders        AuthProvider[]
  refreshTokens        RefreshToken[]
  applications         Application[]
  folders              Folder[]
  documents            Document[]
  notifications        Notification[]
  objectiveCompletions ObjectiveCompletion[]
  promoId              Int?
  promo                Promo? @relation(fields: [promoId], references: [id])
}

enum Provider {
  local
  google
}

model AuthProvider {
  id          Int      @id @default(autoincrement())
  provider    Provider
  provider_id String?
  password    String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([provider, provider_id])
  @@unique([userId, provider])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
}

enum Role {
  ADMIN
  STUDENT
}

model Application {
  id Int @id @default(autoincrement())

  entreprise    String
  lien          String?
  commentaire   String?
  statut        Statut @default(A_CONTACTER)
  contact_nom   String?
  contact_email String?
  contact_tel   String?

  date_candidature DateTime?
  date_relance     DateTime?
  
  outcome Outcome? @default(RAPPEL)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

enum Outcome {
  RAPPEL
  SANS_REPONSE
  ENTRETIEN
  DECROCHEE
}

enum Statut {
  A_CONTACTER
  ENVOYE
  RELANCE
  EN_DISCUSSION
  REPONSE_POSITIVE
  REFUS
}

model Folder {
  id Int @id @default(autoincrement())

  name String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  created_at DateTime @default(now())

  documents Document[]
}

model Document {
  id Int @id @default(autoincrement())

  name        String
  mimeType    String
  size        Int
  storageKey  String

  folderId Int?
  folder   Folder? @relation(fields: [folderId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])
  
  created_at DateTime @default(now())
}

enum NotifType {
  DOCUMENT_ADDED
  APPLICATION_STATUS
  OBJECTIVE_CREATED
}

model Notification {
  id Int @id @default(autoincrement())

  type    NotifType
  payload Json
  read    Boolean @default(false)

  userId  Int
  user    User @relation(fields: [userId], references: [id])

  created_at DateTime @default(now())
}

model Promo {
  id Int @id @default(autoincrement())

  name        String
  created_at  DateTime @default(now())

  users       User[]
  objectives  Objective[]
}

model Objective {
  id Int @id @default(autoincrement())

  title       String
  description String?
  deadline    DateTime?

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id])

  completions ObjectiveCompletion[]

  created_at  DateTime @default(now())
}

model ObjectiveCompletion {
  id      Int     @id @default(autoincrement())
  done    Boolean @default(false)

  objectiveId Int
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  @@unique([objectiveId, userId])
}