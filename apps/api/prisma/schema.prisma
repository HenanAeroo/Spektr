generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(255)
  first_name  String?
  last_name   String?
  role        Role     @default(STUDENT)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  authProviders AuthProvider[]
  refreshTokens RefreshToken[]
  applications  Application[]
}

enum Provider {
  local
  google
}

model AuthProvider {
  id          Int      @id @default(autoincrement())
  provider    Provider
  provider_id String?
  password    String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([provider, provider_id])
  @@unique([userId, provider])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
}

enum Role {
  ADMIN
  STUDENT
}

model Application {
  id                Int @id @default(autoincrement())

  entreprise        String
  lien              String?
  commentaire       String?
  statut            Statut @default(A_CONTACTER)
  contact_nom       String?
  contact_email     String?
  contact_tel       String?

  date_candidature  DateTime?
  date_relance      DateTime?
  
  outcome           Outcome? @default(RAPPEL)

  created_at        DateTime @default(now())
  modified_at       DateTime @updatedAt

  userId            Int
  user              User @relation(fields: [userId], references: [id])
}

enum Outcome {
    RAPPEL
    SANS_REPONSE
    ENTRETIEN
    DECROCHEE
}

enum Statut {
  A_CONTACTER
  ENVOYE
  RELANCE
  EN_DISCUSSION
  REPONSE_POSITIVE
  REFUS
}