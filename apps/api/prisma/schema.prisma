generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(255)
  first_name  String?
  last_name   String?
  role        Role     @default(STUDENT)

  emailVerified       Boolean @default(false)
  verificationToken   String?
  verificationExpiry  DateTime?

  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?

  created_at    DateTime  @default(now())
  modified_at   DateTime  @updatedAt
  last_seen_at DateTime?

  authProviders           AuthProvider[]
  refreshTokens           RefreshToken[]
  applications            Application[]
  folders                 Folder[]
  documents               Document[]
  notifications           Notification[]
  objectiveCompletions    ObjectiveCompletion[]
  adminPromos             AdminPromo[]    @relation("AdminPromos")
  sentCommunications      Communication[] @relation("SentCommunications")
  receivedCommunications  Communication[] @relation("ReceivedCommunications")

  promoId              Int?
  promo                Promo? @relation(fields: [promoId], references: [id], onDelete: SetNull)

  @@index([promoId])
  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@index([last_seen_at])
}

enum Provider {
  local
  google
}

model AuthProvider {
  id          Int      @id @default(autoincrement())
  provider    Provider
  provider_id String?
  password    String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([provider, provider_id])
  @@unique([userId, provider])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([userId])
  @@index([expires_at])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum AdminPromoRole {
  OWNER
  COLLABORATOR
}

model Application {
  id Int @id @default(autoincrement())

  entreprise    String
  lien          String?
  commentaire   String?
  statut        Statut @default(A_CONTACTER)
  contact_nom   String?
  contact_email String?
  contact_tel   String?

  date_candidature        DateTime?
  date_relance_contact    DateTime?
  date_relance_tel        DateTime?
  date_reponse_entreprise DateTime?
  
  outcome Outcome? @default(RAPPEL)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Outcome {
  RAPPEL
  SANS_REPONSE
  ENTRETIEN
  DECROCHEE
}

enum Statut {
  A_CONTACTER
  ENVOYE
  RELANCE
  EN_DISCUSSION
  REPONSE_POSITIVE
  REFUS
}

model Folder {
  id Int @id @default(autoincrement())

  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  documents Document[]

  @@index([userId])
}

model Document {
  id Int @id @default(autoincrement())

  name        String
  mimeType    String
  size        Int
  storageKey  String
  status      DocumentStatus @default(PENDING)
  docType     DocumentType   @default(OTHER)

  folderId Int?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([userId])
  @@index([folderId])
  @@index([status, docType])
}

enum NotifType {
  DOCUMENT_ADDED
  APPLICATION_STATUS
  OBJECTIVE_CREATED
  INACTIVITY_ALERT
  DOCUMENT_REVIEW
}

enum DocumentStatus {
  PENDING
  VALIDATED
  TO_CORRECT
}

enum DocumentType {
  CV
  LM
  OTHER
}

/// Audit trail of Document.status changes. Rows are written exclusively by the
/// PostgreSQL trigger `trg_document_status_change` (see migration
/// `add_document_status_trigger`), never from application code — the model is
/// declared here only so Prisma tracks the table and won't drop it as drift.
model DocumentStatusAudit {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  oldStatus  String?  @map("old_status")
  newStatus  String   @map("new_status")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
}

model Notification {
  id Int @id @default(autoincrement())

  type    NotifType
  payload Json
  read    Boolean @default(false)

  userId  Int
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([userId, created_at])
}

model Promo {
  id Int @id @default(autoincrement())

  name        String
  created_at  DateTime @default(now())

  users       User[]
  objectives  Objective[]
  adminPromos AdminPromo[]
}

model AdminPromo {
  adminId Int
  admin   User           @relation("AdminPromos", fields: [adminId], references: [id], onDelete: Cascade)
  promoId Int
  promo   Promo          @relation(fields: [promoId], references: [id], onDelete: Cascade)
  role    AdminPromoRole @default(OWNER)

  created_at DateTime @default(now())

  @@id([adminId, promoId])
}

model Objective {
  id Int @id @default(autoincrement())

  title       String
  description String?
  deadline    DateTime?

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  completions ObjectiveCompletion[]

  created_at  DateTime @default(now())

  @@index([promoId])
}

model ObjectiveCompletion {
  id      Int     @id @default(autoincrement())
  done    Boolean @default(false)

  objectiveId Int
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  @@unique([objectiveId, userId])
  @@index([userId])
}

enum CommunicationType {
  EMAIL
  FEEDBACK
}

model Communication {
  id      Int @id @default(autoincrement())
  type    CommunicationType
  subject String?
  body    String?
  score   Int?

  senderId  Int
  sender    User @relation("SentCommunications", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId Int
  recipient   User @relation("ReceivedCommunications", fields: [recipientId], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
}